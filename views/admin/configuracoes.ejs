<%- include("partials/inicio", { titulo, paginaAtual, usuario }) %>

<section class="dashboard-hero">
    <div>
        <span class="eyebrow">Personalização</span>
        <h1>Configurações da Loja</h1>
        <p>Personalize as informações e a aparência do seu catálogo.</p>
    </div>

    <% if (usuario.lojaSlug) { %>
        <a href="/catalogo/<%= encodeURIComponent(usuario.lojaSlug) %>" target="_blank" rel="noopener noreferrer" class="secondary-action">
            <i class="bi bi-eye-fill"></i> Visualizar catálogo
        </a>
    <% } %>
</section>

<% if (sucesso) { %>
    <div class="alert alert-success" role="alert"><i class="bi bi-check-circle-fill"></i> <span><%= sucesso %></span></div>
<% } %>
<% if (erro) { %>
    <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill"></i> <span><%= erro %></span></div>
<% } %>

<div class="alert alert-danger configuracao-erro-imagem" role="alert" data-image-error hidden>
    <i class="bi bi-exclamation-triangle-fill"></i>
    <span data-image-error-message></span>
</div>

<form method="POST" action="/admin/configuracoes" enctype="multipart/form-data" class="configuracoes-form" data-configuracoes-form>
    <input type="hidden" name="logo_atual" value="<%= loja.logo || '' %>">
    <input type="hidden" name="banner_atual" value="<%= loja.banner || '' %>">
    <input type="hidden" name="favicon_atual" value="<%= loja.favicon || '' %>">
    <input type="hidden" name="remover_banner" id="remover_banner" value="0">

    <nav class="configuracoes-tabs" aria-label="Seções das configurações">
        <button type="button" class="configuracao-tab active" data-config-tab="identidade" aria-selected="true"><i class="bi bi-shop"></i> Identidade</button>
        <button type="button" class="configuracao-tab" data-config-tab="aparencia" aria-selected="false"><i class="bi bi-palette-fill"></i> Aparência</button>
        <button type="button" class="configuracao-tab" data-config-tab="contato" aria-selected="false"><i class="bi bi-chat-dots-fill"></i> Contato</button>
        <button type="button" class="configuracao-tab" data-config-tab="sobre" aria-selected="false"><i class="bi bi-info-circle-fill"></i> Sobre</button>
    </nav>

    <section class="configuracao-painel active" data-config-panel="identidade">
        <article class="panel-card configuracao-card">
            <div class="panel-heading"><div><span class="eyebrow">Identidade</span><h2>Informações principais</h2><p>Dados usados para identificar sua loja no catálogo.</p></div></div>

            <div class="configuracao-grid">
                <div class="configuracao-campo campo-largo">
                    <label for="nome">Nome da loja <span aria-hidden="true">*</span></label>
                    <input id="nome" name="nome" type="text" maxlength="120" required value="<%= loja.nome || '' %>" placeholder="Ex.: Loja da Maria">
                </div>
                <div class="configuracao-campo campo-largo">
                    <label for="slogan">Slogan</label>
                    <input id="slogan" name="slogan" type="text" maxlength="180" value="<%= loja.slogan || '' %>" placeholder="Ex.: Qualidade e preço baixo todos os dias">
                    <small>Uma frase curta que representa sua loja.</small>
                </div>
            </div>

            <div class="configuracao-imagens">
                <article class="imagem-config-card">
                    <div class="imagem-config-titulo"><i class="bi bi-shop-window"></i><div><strong>Logo da loja</strong><small>Ajuste automático para 512 × 512 px. Envie uma imagem de até 8 MB.</small></div></div>
                    <div class="imagem-config-preview logo-preview" data-preview-container="logo">
                        <% if (loja.logo) { %><img src="<%= loja.logo %>" alt="Logo atual da loja"><% } else { %><div class="imagem-placeholder"><i class="bi bi-image"></i><span>Nenhuma logo cadastrada</span></div><% } %>
                    </div>
                    <label class="botao-upload" for="logo"><i class="bi bi-upload"></i> Escolher logo</label>
                    <input id="logo" name="logo" type="file" accept=".jpg,.jpeg,.png,.gif,.bmp,.tif,.tiff" data-image-upload="logo" hidden>
                </article>

                <article class="imagem-config-card">
                    <div class="imagem-config-titulo"><i class="bi bi-card-image"></i><div><strong>Banner da loja</strong><small>Ajuste automático para 1600 × 600 px. Envie uma imagem de até 8 MB.</small></div></div>
                    <div class="imagem-config-preview banner-preview" data-preview-container="banner">
                        <% if (loja.banner) { %><img src="<%= loja.banner %>" alt="Banner atual da loja"><% } else { %><div class="imagem-placeholder"><i class="bi bi-image"></i><span>Nenhum banner cadastrado</span></div><% } %>
                    </div>
                    <div class="imagem-config-acoes">
                        <label class="botao-upload" for="banner"><i class="bi bi-upload"></i> Escolher banner</label>
                        <button type="button" class="botao-remover-imagem" data-remove-banner <%= loja.banner ? '' : 'disabled' %>><i class="bi bi-trash3"></i> Remover</button>
                    </div>
                    <input id="banner" name="banner" type="file" accept=".jpg,.jpeg,.png,.gif,.bmp,.tif,.tiff" data-image-upload="banner" hidden>
                </article>

                <article class="imagem-config-card">
                    <div class="imagem-config-titulo"><i class="bi bi-app-indicator"></i><div><strong>Favicon</strong><small>Ajuste automático para 512 × 512 px. Envie uma imagem de até 8 MB.</small></div></div>
                    <div class="imagem-config-preview favicon-preview" data-preview-container="favicon">
                        <% if (loja.favicon) { %><img src="<%= loja.favicon %>" alt="Favicon atual"><% } else { %><div class="imagem-placeholder"><i class="bi bi-app"></i><span>Nenhum favicon cadastrado</span></div><% } %>
                    </div>
                    <label class="botao-upload" for="favicon"><i class="bi bi-upload"></i> Escolher favicon</label>
                    <input id="favicon" name="favicon" type="file" accept=".jpg,.jpeg,.png,.gif,.bmp,.tif,.tiff" data-image-upload="favicon" hidden>
                </article>
            </div>

            <div class="configuracao-aviso"><i class="bi bi-info-circle-fill"></i><div><strong>Otimização automática</strong><p>Você escolhe a imagem e o sistema ajusta o tamanho, o enquadramento e o formato antes de salvar. O arquivo original pode ter até 8 MB.</p></div></div>
        </article>
    </section>

    <section class="configuracao-painel" data-config-panel="aparencia" hidden>
        <article class="panel-card configuracao-card">
            <div class="panel-heading"><div><span class="eyebrow">Aparência</span><h2>Cores e textos do catálogo</h2><p>Defina a identidade visual exibida aos clientes.</p></div></div>
            <div class="configuracao-grid">
                <div class="configuracao-campo"><label for="cor_primaria">Cor principal</label><div class="campo-cor"><input id="cor_primaria" name="cor_primaria" type="color" value="<%= loja.cor_primaria || '#0d6efd' %>" data-color-picker data-color-target="cor_primaria_texto"><input id="cor_primaria_texto" type="text" value="<%= loja.cor_primaria || '#0d6efd' %>" maxlength="7" data-color-text data-color-target="cor_primaria" aria-label="Código da cor principal"></div></div>
                <div class="configuracao-campo"><label for="cor_secundaria">Cor secundária</label><div class="campo-cor"><input id="cor_secundaria" name="cor_secundaria" type="color" value="<%= loja.cor_secundaria || '#212529' %>" data-color-picker data-color-target="cor_secundaria_texto"><input id="cor_secundaria_texto" type="text" value="<%= loja.cor_secundaria || '#212529' %>" maxlength="7" data-color-text data-color-target="cor_secundaria" aria-label="Código da cor secundária"></div></div>
                <div class="configuracao-campo campo-largo"><label for="mensagem_boas_vindas">Mensagem de boas-vindas</label><textarea id="mensagem_boas_vindas" name="mensagem_boas_vindas" maxlength="500" rows="4" placeholder="Ex.: Bem-vindo! Confira nossos produtos."><%= loja.mensagem_boas_vindas || '' %></textarea></div>
                <div class="configuracao-campo campo-largo"><label for="texto_rodape">Texto do rodapé</label><textarea id="texto_rodape" name="texto_rodape" maxlength="500" rows="3" placeholder="Ex.: Todos os direitos reservados."><%= loja.texto_rodape || '' %></textarea></div>
            </div>
            <div class="configuracao-preview" data-config-preview style="--preview-primary:<%= loja.cor_primaria || '#0d6efd' %>;--preview-secondary:<%= loja.cor_secundaria || '#212529' %>">
                <span>Pré-visualização das cores</span><div class="preview-cabecalho"><strong data-preview-store-name><%= loja.nome || 'Nome da loja' %></strong><button type="button">Ver carrinho</button></div><div class="preview-conteudo"><div class="preview-produto"></div><div><strong>Produto de exemplo</strong><p>R$ 99,90</p></div></div>
            </div>
        </article>
    </section>

    <section class="configuracao-painel" data-config-panel="contato" hidden>
        <article class="panel-card configuracao-card">
            <div class="panel-heading"><div><span class="eyebrow">Contato</span><h2>Redes sociais e atendimento</h2><p>Ajude seus clientes a encontrarem sua empresa.</p></div></div>
            <div class="configuracao-grid">
                <div class="configuracao-campo"><label for="instagram"><i class="bi bi-instagram"></i> Instagram</label><input id="instagram" name="instagram" type="text" maxlength="255" value="<%= loja.instagram || '' %>" placeholder="@sualoja ou link completo"></div>
                <div class="configuracao-campo"><label for="facebook"><i class="bi bi-facebook"></i> Facebook</label><input id="facebook" name="facebook" type="text" maxlength="255" value="<%= loja.facebook || '' %>" placeholder="Link da página"></div>
                <div class="configuracao-campo"><label for="tiktok"><i class="bi bi-tiktok"></i> TikTok</label><input id="tiktok" name="tiktok" type="text" maxlength="255" value="<%= loja.tiktok || '' %>" placeholder="@sualoja ou link completo"></div>
                <div class="configuracao-campo"><label for="site"><i class="bi bi-globe2"></i> Site</label><input id="site" name="site" type="text" maxlength="255" value="<%= loja.site || '' %>" placeholder="https://www.sualoja.com.br"></div>
                <div class="configuracao-campo campo-largo"><label for="endereco"><i class="bi bi-geo-alt-fill"></i> Endereço</label><textarea id="endereco" name="endereco" maxlength="500" rows="3" placeholder="Rua, número, bairro, cidade e estado"><%= loja.endereco || '' %></textarea></div>
                <div class="configuracao-campo campo-largo"><label for="horario_atendimento"><i class="bi bi-clock-fill"></i> Horário de atendimento</label><textarea id="horario_atendimento" name="horario_atendimento" maxlength="500" rows="3" placeholder="Ex.: Segunda a sexta, das 8h às 18h"><%= loja.horario_atendimento || '' %></textarea></div>
            </div>
        </article>
    </section>

    <section class="configuracao-painel" data-config-panel="sobre" hidden>
        <article class="panel-card configuracao-card">
            <div class="panel-heading"><div><span class="eyebrow">Sobre</span><h2>História da loja</h2><p>Conte aos clientes um pouco sobre o seu negócio.</p></div></div>
            <div class="configuracao-grid">
                <div class="configuracao-campo campo-largo"><label for="descricao">Descrição da loja</label><textarea id="descricao" name="descricao" maxlength="3000" rows="8" placeholder="Conte a história, os diferenciais e os valores da sua loja."><%= loja.descricao || '' %></textarea><div class="contador-caracteres"><span data-description-count>0</span>/3000</div></div>
                <div class="configuracao-campo"><label for="ano_fundacao">Ano de fundação</label><input id="ano_fundacao" name="ano_fundacao" type="number" min="1800" max="<%= new Date().getFullYear() %>" value="<%= loja.ano_fundacao || '' %>" placeholder="Ex.: 2020" inputmode="numeric"></div>
            </div>
        </article>
    </section>

    <div class="configuracoes-acoes">
        <% if (usuario.lojaSlug) { %><a href="/catalogo/<%= encodeURIComponent(usuario.lojaSlug) %>" target="_blank" rel="noopener noreferrer" class="secondary-action"><i class="bi bi-eye"></i> Ver catálogo</a><% } %>
        <button type="submit" class="primary-action" data-submit-config><i class="bi bi-check-lg"></i> Salvar configurações</button>
    </div>
</form>

<%- include("partials/fim") %>
