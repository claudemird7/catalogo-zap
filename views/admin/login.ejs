<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title><%= titulo %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            min-height: 100vh;
            background: #f3f5f7;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            border: 0;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        }

        .form-control {
            min-height: 48px;
            border-radius: 10px;
        }

        .btn-entrar {
            min-height: 48px;
            border-radius: 10px;
        }
    </style>
</head>

<body>
    <main class="login-container">
        <section class="card login-card">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h1 class="h3 fw-bold mb-2">
                        Catálogo Zap
                    </h1>

                    <p class="text-secondary mb-0">
                        Acesse o painel administrativo
                    </p>
                </div>

                <% if (erro) { %>
                    <div
                        class="alert alert-danger"
                        role="alert"
                    >
                        <%= erro %>
                    </div>
                <% } %>

                <form
                    action="/admin/login"
                    method="POST"
                >
                    <div class="mb-3">
                        <label
                            for="email"
                            class="form-label"
                        >
                            E-mail
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            value="<%= email %>"
                            autocomplete="email"
                            required
                        >
                    </div>

                    <div class="mb-4">
                        <label
                            for="senha"
                            class="form-label"
                        >
                            Senha
                        </label>

                        <input
                            type="password"
                            id="senha"
                            name="senha"
                            class="form-control"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <button
                        type="submit"
                        class="btn btn-primary btn-entrar w-100 fw-semibold"
                    >
                        Entrar
                    </button>
                </form>
            </div>
        </section>
    </main>
</body>
</html>
