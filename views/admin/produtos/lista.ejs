<%- include("../partials/inicio") %>
<section class="page-heading"><div><span class="page-eyebrow">Gestão do catálogo</span><h1>Produtos</h1><p>Cadastre, pesquise e mantenha os itens exibidos no catálogo.</p></div><div class="page-actions"><button type="button" class="secondary-action" data-coming-soon="Importação por planilha"><i class="bi bi-file-earmark-arrow-up"></i> Importar Excel</button><a href="/admin/produtos/novo" class="primary-action"><i class="bi bi-plus-lg"></i> Novo produto</a></div></section>
<% if (mensagem) { %><div class="admin-alert success"><i class="bi bi-check-circle-fill"></i><%= mensagem %></div><% } %>
<% if (erro) { %><div class="admin-alert danger"><i class="bi bi-exclamation-triangle-fill"></i><%= erro %></div><% } %>
<section class="panel-card products-panel">
<form class="product-filters" method="GET"><label class="filter-search"><i class="bi bi-search"></i><input name="busca" value="<%= filtros.busca %>" placeholder="Pesquisar produto"></label><select name="categoriaId"><option value="">Todas as categorias</option><% categorias.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filtros.categoriaId)===String(c.id)?'selected':'' %>><%= c.nome %></option><% }) %></select><select name="status"><option value="">Todos os status</option><option value="ativo" <%= filtros.status==='ativo'?'selected':'' %>>Ativos</option><option value="inativo" <%= filtros.status==='inativo'?'selected':'' %>>Inativos</option></select><button class="filter-button">Filtrar</button><a class="clear-filter" href="/admin/produtos">Limpar</a></form>
<div class="table-summary"><strong><%= paginacao.total %></strong> <%= paginacao.total===1?'produto encontrado':'produtos encontrados' %></div>
<% if (!produtos.length) { %><div class="empty-state"><i class="bi bi-box-seam"></i><h2>Nenhum produto encontrado</h2><p>Altere os filtros ou cadastre um produto.</p><a href="/admin/produtos/novo" class="primary-action">Cadastrar produto</a></div><% } else { %>
<div class="product-table-wrap"><table class="product-table"><thead><tr><th>Produto</th><th>Categoria</th><th>Preço</th><th>Status</th><th>Ações</th></tr></thead><tbody>
<% produtos.forEach(p=>{ %><tr><td data-label="Produto"><div class="product-identity"><div class="product-thumb"><% if(p.imagem){ %><img src="<%= p.imagem %>" alt=""><% }else{ %><i class="bi bi-image"></i><% } %></div><div><strong><%= p.nome %></strong><span>#<%= p.id %></span></div></div></td><td data-label="Categoria"><%= p.categoria_nome||'Sem categoria' %></td><td data-label="Preço"><div class="price-stack"><% if(p.preco_promocional!==null){ %><strong><%= Number(p.preco_promocional).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></strong><del><%= Number(p.preco).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></del><% }else{ %><strong><%= Number(p.preco).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></strong><% } %></div></td><td data-label="Status"><span class="status-pill <%= p.ativo?'active':'inactive' %>"><%= p.ativo?'Ativo':'Inativo' %></span></td><td data-label="Ações"><div class="row-actions"><a class="icon-action" href="/admin/produtos/<%= p.id %>/editar"><i class="bi bi-pencil"></i></a><form action="/admin/produtos/<%= p.id %>/excluir" method="POST" data-delete-product="<%= p.nome %>"><button class="icon-action danger"><i class="bi bi-trash3"></i></button></form></div></td></tr><% }) %>
</tbody></table></div>
<% if(paginacao.totalPaginas>1){ const q=`busca=${encodeURIComponent(filtros.busca)}&categoriaId=${encodeURIComponent(filtros.categoriaId)}&status=${encodeURIComponent(filtros.status)}`; %><nav class="admin-pagination"><a class="<%= paginacao.paginaAtual===1?'disabled':'' %>" href="?<%= q %>&pagina=<%= paginacao.paginaAtual-1 %>">‹</a><span>Página <strong><%= paginacao.paginaAtual %></strong> de <strong><%= paginacao.totalPaginas %></strong></span><a class="<%= paginacao.paginaAtual===paginacao.totalPaginas?'disabled':'' %>" href="?<%= q %>&pagina=<%= paginacao.paginaAtual+1 %>">›</a></nav><% } %>
<% } %></section><%- include("../partials/fim") %>
