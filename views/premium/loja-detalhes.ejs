<%- include("partials/inicio", { titulo, paginaAtual, usuario }) %>
<% if (mensagem) { %><div class="alert-success"><%= mensagem %></div><% } %>
<div class="detail-header"><div><a class="back-link" href="/premium/lojas">← Voltar para lojas</a><h2><%= loja.nome %></h2><p>/catalogo/<%= loja.slug %></p></div><div class="detail-actions"><a class="secondary-button" target="_blank" href="/catalogo/<%= loja.slug %>"><i class="bi bi-box-arrow-up-right"></i> Catálogo</a><a class="primary-button" href="/premium/lojas/<%= loja.id %>/editar"><i class="bi bi-pencil"></i> Editar</a></div></div>
<section class="metric-grid compact">
<article class="metric-card"><i class="bi bi-box"></i><div><span>Produtos</span><strong><%= loja.total_produtos %></strong></div></article>
<article class="metric-card"><i class="bi bi-tags"></i><div><span>Categorias</span><strong><%= loja.total_categorias %></strong></div></article>
<article class="metric-card"><i class="bi bi-exclamation-triangle"></i><div><span>Sem estoque</span><strong><%= loja.sem_estoque %></strong></div></article>
<article class="metric-card"><i class="bi bi-clock"></i><div><span>Último acesso</span><strong class="small-value"><%= loja.ultimo_acesso ? new Date(loja.ultimo_acesso).toLocaleDateString('pt-BR') : 'Nunca' %></strong></div></article>
</section>
<section class="dashboard-columns">
<article class="panel-card"><div class="panel-title"><h2>Dados da loja</h2></div><dl class="details-list"><div><dt>Responsável</dt><dd><%= loja.responsavel || '-' %></dd></div><div><dt>E-mail</dt><dd><%= loja.usuario_email || loja.email || '-' %></dd></div><div><dt>WhatsApp</dt><dd><%= loja.whatsapp || '-' %></dd></div><div><dt>Plano</dt><dd><%= loja.plano_nome || '-' %></dd></div><div><dt>Vencimento</dt><dd><%= loja.vencimento ? new Date(loja.vencimento+'T12:00:00').toLocaleDateString('pt-BR') : 'Sem vencimento' %></dd></div><div><dt>Status</dt><dd><span class="status <%= loja.ativo?'ativo':'bloqueado' %>"><%= loja.ativo?'Ativa':'Bloqueada' %></span></dd></div></dl></article>
<article class="panel-card"><div class="panel-title"><h2>Ações administrativas</h2></div><div class="action-list"><a href="/premium/lojas/<%= loja.id %>/editar"><i class="bi bi-pencil-square"></i><span><strong>Editar dados e plano</strong><small>Atualize cadastro, assinatura e vencimento</small></span></a><a href="/premium/lojas/<%= loja.id %>/resetar-senha"><i class="bi bi-key"></i><span><strong>Redefinir senha</strong><small>Crie uma nova senha de acesso</small></span></a><form method="post" action="/premium/lojas/<%= loja.id %>/entrar"><button><i class="bi bi-person-gear"></i><span><strong>Entrar como lojista</strong><small>Acesso temporário para suporte</small></span></button></form><form method="post" action="/premium/lojas/<%= loja.id %>/alternar"><button><i class="bi <%= loja.ativo?'bi-slash-circle':'bi-check-circle' %>"></i><span><strong><%= loja.ativo?'Bloquear loja':'Ativar loja' %></strong><small>Também altera o acesso do lojista</small></span></button></form></div></article>
</section>
<section class="panel-card"><div class="panel-title"><h2>Histórico da loja</h2></div><div class="timeline"><% if(!atividades.length){ %><p class="empty-state">Sem atividades registradas.</p><% } %><% atividades.forEach(a=>{ %><div class="timeline-item"><i class="bi bi-clock-history"></i><div><strong><%= a.acao.replaceAll('_',' ') %></strong><p><%= a.detalhes||'' %></p><small><%= new Date(a.criado_em).toLocaleString('pt-BR') %></small></div></div><% }) %></div></section>
<%- include("partials/fim") %>
