<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= titulo %> | Catálogo Zap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/premium.css">
</head>
<body class="premium-body">
<div class="premium-shell">
    <aside class="premium-sidebar">
        <a href="/premium" class="premium-brand"><i class="bi bi-stars"></i><span>Catálogo Zap</span></a>
        <nav>
            <a class="<%= paginaAtual==='dashboard'?'ativo':'' %>" href="/premium"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a>
            <a class="<%= paginaAtual==='lojas'?'ativo':'' %>" href="/premium/lojas"><i class="bi bi-shop"></i><span>Lojas</span></a>
            <a class="<%= paginaAtual==='planos'?'ativo':'' %>" href="/premium/planos"><i class="bi bi-gem"></i><span>Planos</span></a>
        </nav>
        <div class="premium-sidebar-bottom">
            <div class="premium-user"><span><%= usuario.nome?.charAt(0).toUpperCase() %></span><div><strong><%= usuario.nome %></strong><small>Super Admin</small></div></div>
            <form action="/admin/sair" method="post"><button class="link-button"><i class="bi bi-box-arrow-right"></i> Sair</button></form>
        </div>
    </aside>
    <main class="premium-main">
        <header class="premium-topbar">
            <div><span class="eyebrow">Administração da plataforma</span><h1><%= titulo %></h1></div>
            <a class="primary-button" href="/premium/lojas/nova"><i class="bi bi-plus-lg"></i> Nova loja</a>
        </header>
