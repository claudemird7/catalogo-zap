<%- include("partials/inicio", { titulo, paginaAtual, usuario }) %>
<% if(mensagem){ %><div class="alert-success"><%= mensagem %></div><% } %>
<div class="plans-grid"><% planos.forEach(plano=>{ %><form class="panel-card plan-card" method="post" action="/premium/planos/<%= plano.id %>"><div class="plan-icon"><i class="bi bi-gem"></i></div><label><span>Nome</span><input name="nome" value="<%= plano.nome %>" required></label><label><span>Valor mensal</span><input name="valorMensal" inputmode="decimal" value="<%= Number(plano.valor_mensal).toFixed(2).replace('.',',') %>"></label><label><span>Limite de produtos</span><input type="number" min="0" name="limiteProdutos" value="<%= plano.limite_produtos %>"><small>Use 0 para ilimitado</small></label><label class="check"><input type="checkbox" name="permiteAtacado" <%= plano.permite_atacado?'checked':'' %>> Permite atacado</label><label class="check"><input type="checkbox" name="permiteEstoque" <%= plano.permite_estoque?'checked':'' %>> Permite estoque</label><label class="check"><input type="checkbox" name="ativo" <%= plano.ativo?'checked':'' %>> Plano ativo</label><button class="primary-button">Salvar plano</button></form><% }) %></div>
<%- include("partials/fim") %>
